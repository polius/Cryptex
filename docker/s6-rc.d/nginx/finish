#!/bin/sh
# s6 restarts a crashed service. If it crashes 5 times within a minute, stop the container
# so the orchestrator (Docker restart policy, Kubernetes) restarts it from scratch.
svc=$(basename "$(pwd)")
f="/run/cryptex-crashes-$svc"
now=$(date +%s)
[ "$1" = 0 ] && exit 0
echo "$now" >> "$f"
recent=$(awk -v n="$now" '$1 > n - 60' "$f" | wc -l)
if [ "$recent" -ge 5 ]; then
  echo "cryptex: $svc keeps crashing, stopping the container" >&2
  echo 1 > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
